{
  "name": "shop",
  "services": {
    "web": { "image": "nginx:1.24.0", "depends_on": { "app": { "condition": "service_started" } }, "ports": [ { "published": "443", "target": 443 } ] },
    "app": { "image": "php:8.1-fpm", "depends_on": ["db", "cache", "not-a-service"], "links": ["db:database"] },
    "db": { "image": "postgres:16" },
    "cache": { "image": "redis:7" }
  }
}
